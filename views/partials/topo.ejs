<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Caderno de Campo</title>
  <link rel="stylesheet" href="/vendor/phosphor/style.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app">
  <aside class="lateral">
    <div class="marca">
      <div class="marca-icone"><i class="ph-fill ph-notebook"></i></div>
      <div>
        <div class="marca-nome">Caderno<br>de Campo</div>
        <div class="marca-sub">Sítio Santa Luzia</div>
      </div>
    </div>
    <nav class="menu">
      <a href="/" class="<%= ativo === 'painel' ? 'ativo' : '' %>"><i class="ph-fill ph-house"></i>Painel</a>
      <a href="/talhoes" class="<%= ativo === 'talhoes' ? 'ativo' : '' %>"><i class="ph-fill ph-plant"></i>Talhões</a>
      <a href="/insumos" class="<%= ativo === 'insumos' ? 'ativo' : '' %>"><i class="ph-fill ph-package"></i>Insumos</a>
      <a href="/relatorios" class="<%= ativo === 'relatorios' ? 'ativo' : '' %>"><i class="ph-fill ph-chart-bar"></i>Relatórios</a>
      <a href="/banco" class="<%= ativo === 'banco' ? 'ativo' : '' %>"><i class="ph-fill ph-database"></i>Banco de dados</a>
    </nav>
    <div class="lateral-rodape">Pompeia/SP<br>IAL-215 · Banco de Dados NoSQL<br>FATEC Pompeia</div>
  </aside>
  <main class="principal">
    <% if (aviso) { %>
      <div class="faixa <%= aviso.tipo %>"><i class="ph-fill <%= aviso.tipo === 'erro' ? 'ph-x-circle' : 'ph-check-circle' %>"></i><%= aviso.texto %></div>
    <% } %>
